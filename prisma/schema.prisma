// PSYBOSS Prisma schema — Turso libSQL via driver adapter.
// The music domain model: Project → PatternSteps + LoadedSamples.

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id            String   @id @default(cuid())
  name          String
  bpm           Int      @default(144)
  seed          BigInt   @default(2654435769) // 0x9e3779b9
  patternEnabled Boolean @default(false)
  steps         PatternStep[]
  samples       LoadedSample[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([updatedAt])
}

model PatternStep {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  track        Int      // 0-3 (KICK/SNARE/HAT/BASS)
  step         Int      // 0-15 (16th-note position)
  active       Boolean  @default(false)
  scene        Int      @default(0) // 0-3 variant
  condition    String   @default("always") // JSON: TrigCondition
  locks        String   @default("[]") // JSON: ParameterLock[]
  loadedSampleId String? // FK to LoadedSample.id (null = procedural DSP)
  loadedSample LoadedSample? @relation(fields: [loadedSampleId], references: [id], onDelete: SetNull)

  @@unique([projectId, track, step])
  @@index([projectId])
}

model LoadedSample {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sampleId     String   // runtime id (e.g. "sample-abc123def456")
  name         String
  license      String   // CC0, CC-BY, etc.
  source       String   // URL
  author       String?
  fingerprint  String   // SHA-256 (64 hex chars) or dsp:<id>:<seed>
  verifiedAt   BigInt
  duration     Float    // seconds
  sampleRate   Int
  steps        PatternStep[] // steps that reference this sample
  createdAt    DateTime @default(now())

  @@unique([projectId, sampleId])
  @@index([projectId])
}
